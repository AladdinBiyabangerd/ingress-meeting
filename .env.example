# Copy to .env and fill in before docker compose up
# OPENAI_API_KEY is optional — only for standalone /api/openai/process.
# Whisper jobs do NOT summarize; Academy builds lesson summaries.
# OPENAI_API_KEY=
API_SECRET_KEY=
# Academy webhook base (no trailing slash). Meeting POSTs {base}/{jobId}/complete
# Example: https://ingress.academy/portal/api/meeting/jobs
ACADEMY_CALLBACK_BASE_URL=
# whisper.cpp ggml model (medium = one step faster than large-v3-q5_0)
# Options: large-v3-q5_0 | large-v3-q8_0 | large-v3 | medium | medium-q5_0 | small | base
WHISPER_MODEL=medium
# 0 = all CPU cores
WHISPER_THREADS=0
JAVA_OPTS=-Xms512m -Xmx2g
